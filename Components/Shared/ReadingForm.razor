@using WaterTemperatures.Models

@* Shared add/edit form for a temperature reading. The parent owns persistence
   and navigation; this component only renders fields, validates, and raises
   OnValidSubmit. *@

<EditForm Model="Model" OnValidSubmit="OnValidSubmit" FormName="readingForm">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">@AppText.FieldTemperature</label>
        @* Most readings are entered on a phone. inputmode="decimal" asks for the big
           numeric keypad rather than the full punctuation keyboard type=number gets on
           iOS. Celsius is a non-nullable decimal, so the field always starts at "0";
           selecting it on focus means the first keystroke replaces that instead of
           landing after it. *@
        <InputNumber @bind-Value="Model.Celsius" class="form-control" step="0.1" min="0" max="40"
                     inputmode="decimal" onfocus="this.select()" />
        <ValidationMessage For="() => Model.Celsius" />
    </div>

    <div class="mb-3">
        <label class="form-label">@AppText.Date</label>
        @if (DateReadOnly)
        {
            @* The date is the reading's identity, so it cannot be changed in place.
               Rendered as plain text plus a hidden field so the bound value survives. *@
            <input type="date" class="form-control" value="@_measuredOn" readonly disabled />
            <div class="form-text">@AppText.DateIsIdentityHelp</div>
        }
        else
        {
            <InputDate @bind-Value="Model.MeasuredOn" class="form-control" max="@_today" />
            <ValidationMessage For="() => Model.MeasuredOn" />
        }
    </div>

    <div class="mb-3">
        <label class="form-label">@AppText.FieldNote</label>
        <InputTextArea @bind-Value="Model.Note" class="form-control" rows="2" />
        <ValidationMessage For="() => Model.Note" />
    </div>

    <button type="submit" class="btn btn-primary">@SubmitLabel</button>
    <a class="btn btn-secondary" href="/">@AppText.Cancel</a>
    @ExtraButtons
</EditForm>

@code {
    /// <summary>The reading being added or edited. Bound directly by the fields.</summary>
    [Parameter, EditorRequired] public TemperatureReading Model { get; set; } = default!;

    /// <summary>Text on the primary submit button — the caller passes the translated label.</summary>
    [Parameter] public string SubmitLabel { get; set; } = "";

    /// <summary>Raised when the form passes validation.</summary>
    [Parameter] public EventCallback OnValidSubmit { get; set; }

    /// <summary>Optional extra buttons (e.g. Delete) rendered after Cancel.</summary>
    [Parameter] public RenderFragment? ExtraButtons { get; set; }

    /// <summary>
    /// Show the date as read-only. Set when editing: the date is the reading's id, so
    /// changing it in place would mean moving the item to a different key.
    /// </summary>
    [Parameter] public bool DateReadOnly { get; set; }

    private readonly string _today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");

    private string _measuredOn => Model.MeasuredOn.ToString("yyyy-MM-dd");
}
