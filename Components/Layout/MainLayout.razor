@inherits LayoutComponentBase

<div class="page">
    <header class="app-header">
        <a class="app-brand" href="/">@AppText.AppName</a>
        <span class="app-subtitle">@AppText.Subtitle</span>
        <div class="app-auth">
            <LanguageSelector />
            <LoginDisplay />
        </div>
    </header>

    <main class="app-main">
        <article class="content">
            @Body
        </article>
    </main>

    <footer class="app-footer">
        <p>@AppText.FooterMethodNote</p>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @AppText.UnhandledError
    <a href="." class="reload">@AppText.Reload</a>
    <span class="dismiss">🗙</span>
</div>
