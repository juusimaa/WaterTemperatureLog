@inherits LayoutComponentBase

<div class="page">
    <nav class="nav">
        <a class="nav-brand" href="/">@AppText.AppName</a>
        <span class="tag tag-accent-2" style="margin-right: auto;">@AppText.Subtitle</span>
        <LoginDisplay />
        <LanguageSelector />
    </nav>

    <main class="app-main">
        <article class="content">
            @Body
        </article>
    </main>

    <footer class="app-footer">
        <div class="hr" style="width: 100%;"></div>
        <p class="text-muted app-footer-note">@AppText.FooterMethodNote</p>
        <p class="text-muted app-footer-copyright">@AppText.FooterCopyright</p>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @AppText.UnhandledError
    <a href="." class="reload">@AppText.Reload</a>
    <span class="dismiss">🗙</span>
</div>
