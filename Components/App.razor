@using System.Globalization

<!DOCTYPE html>
@* lang follows the request culture so screen readers and browser translation
   pick the right language. *@
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        // Follow the OS light/dark preference automatically (Bootstrap 5.3 color mode).
        // Runs before paint to avoid a flash of the wrong theme.
        window.applyColorMode = function () {
            var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
        };
        window.applyColorMode();
        window.matchMedia('(prefers-color-scheme: dark)')
            .addEventListener('change', window.applyColorMode);
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["WaterTemperatures.styles.css"]" />
    <ImportMap />
    @* SVG is preferred where supported; the PNG is the fallback. Fingerprinted
       hrefs make browsers pick up icon changes instead of serving a stale one. *@
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="icon" type="image/png" sizes="64x64" href="@Assets["favicon.png"]" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Assets["apple-touch-icon.png"]" />
    <title>@AppText.AppName</title>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // Enhanced navigation/reload morphs the server HTML (which has no
        // data-bs-theme) into the DOM and strips the attribute. Re-apply after
        // each enhanced load so the theme survives reloads and navigations.
        Blazor.addEventListener('enhancedload', window.applyColorMode);
    </script>

    @* GoatCounter page-view stats. Counts once per full page load; enhanced
       navigation between routes does not re-trigger it. count.js ignores
       localhost and private IPs, so local runs stay out of the stats. *@
<script data-goatcounter="https://watertemperaturelog.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
</body>

</html>
