@using System.Globalization

<!DOCTYPE html>
@* lang follows the request culture so screen readers and browser translation
   pick the right language. *@
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@AppText.MetaDescription" />
    <base href="/" />

    @* Matches --paper in app.css (light/dark). Duplicated as literal hex rather
       than read from CSS: this drives the browser's own chrome (address bar,
       task switcher), which needs a value before any stylesheet loads. *@
    <meta name="theme-color" content="#E9ECE4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12160F" media="(prefers-color-scheme: dark)" />

    @* One canonical host and one culture-neutral URL: the app has a single production
       origin, and every page is reachable from "/" (root redirects internally), so
       there is no per-page canonical to compute here. *@
    <link rel="canonical" href="@AppText.SiteUrl/" />

    @* Open Graph / Twitter card, so a link shared in Slack, WhatsApp or iMessage
       shows a title, description and the brand mark instead of a bare URL. *@
    <meta property="og:site_name" content="@AppText.AppName" />
    <meta property="og:title" content="@AppText.AppName" />
    <meta property="og:description" content="@AppText.MetaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@AppText.SiteUrl/" />
    <meta property="og:image" content="@($"{AppText.SiteUrl}/{Assets["apple-touch-icon.png"]}")" />
    <meta property="og:locale" content="@OgLocale" />
    <meta property="og:locale:alternate" content="@OgLocaleAlternate" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@AppText.AppName" />
    <meta name="twitter:description" content="@AppText.MetaDescription" />
    <meta name="twitter:image" content="@($"{AppText.SiteUrl}/{Assets["apple-touch-icon.png"]}")" />
    <script>
        // Follow the OS light/dark preference automatically (Bootstrap 5.3 color mode).
        // Runs before paint to avoid a flash of the wrong theme.
        window.applyColorMode = function () {
            var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
        };
        window.applyColorMode();
        window.matchMedia('(prefers-color-scheme: dark)')
            .addEventListener('change', window.applyColorMode);
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["WaterTemperatures.styles.css"]" />
    <ImportMap />
    @* SVG is preferred where supported; the PNG is the fallback. Fingerprinted
       hrefs make browsers pick up icon changes instead of serving a stale one. *@
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="icon" type="image/png" sizes="64x64" href="@Assets["favicon.png"]" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Assets["apple-touch-icon.png"]" />
    <title>@AppText.AppName</title>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // Enhanced navigation/reload morphs the server HTML (which has no
        // data-bs-theme) into the DOM and strips the attribute. Re-apply after
        // each enhanced load so the theme survives reloads and navigations.
        Blazor.addEventListener('enhancedload', window.applyColorMode);
    </script>

    @* GoatCounter page-view stats. Counts once per full page load; enhanced
       navigation between routes does not re-trigger it. count.js ignores
       localhost and private IPs, so local runs stay out of the stats. *@
<script data-goatcounter="https://watertemperaturelog.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
</body>

</html>

@code {
    // og:locale wants "fi_FI" / "en_US", not the bare two-letter tag this app
    // otherwise uses everywhere else — only SupportedCultures needs a real
    // region added if a third language ever joins these two.
    private static string OgLocale =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fi" ? "fi_FI" : "en_US";

    private static string OgLocaleAlternate =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fi" ? "en_US" : "fi_FI";
}
