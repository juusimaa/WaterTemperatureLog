@page "/"
@using System.Globalization
@inject ITemperatureRepository Repository
@rendermode InteractiveServer

<PageTitle>@AppText.AppName</PageTitle>

<h1 class="visually-hidden">@AppText.AppName</h1>

<div class="toolbar">
    <AuthorizeView Roles="@AuthOptions.EditorRole">
        <a class="btn btn-primary" href="/add">@AppText.AddMeasurement</a>
    </AuthorizeView>

    <div class="btn-group view-toggle" role="group" aria-label="@AppText.ViewToggle">
        <button type="button"
                class="btn @(_view == View.List ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => _view = View.List">
            @AppText.ViewList
        </button>
        <button type="button"
                class="btn @(_view == View.Graph ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => _view = View.Graph">
            @AppText.ViewGraph
        </button>
    </div>
</div>

@if (_readings is null)
{
    <p><em>@AppText.Loading</em></p>
}
else if (_readings.Count == 0)
{
    <p>@AppText.NoReadingsYet <a href="/add">@AppText.AddTheFirstOne</a></p>
}
else if (_view == View.List)
{
    <div class="stats">
        <div class="stat">
            <span class="stat-label">@AppText.StatLatest</span>
            <strong>@_latest.Celsius.ToString("0.0") °C</strong>
            <span class="text-muted">@_latest.MeasuredOn.ToString("d")</span>
        </div>
        <div class="stat">
            <span class="stat-label">@AppText.StatAllTimeHigh</span>
            <strong>@_allTimeMax.Celsius.ToString("0.0") °C</strong>
            <span class="text-muted">@_allTimeMax.MeasuredOn.ToString("d")</span>
        </div>
        <div class="stat">
            <span class="stat-label">@AppText.StatAllTimeLow</span>
            <strong>@_allTimeMin.Celsius.ToString("0.0") °C</strong>
            <span class="text-muted">@_allTimeMin.MeasuredOn.ToString("d")</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>@AppText.Date</th>
                    <th class="text-end">°C</th>
                    <th>@AppText.Note</th>
                    @* Editor emails are shown to editors only, not to public visitors. *@
                    <AuthorizeView Roles="@AuthOptions.EditorRole" Context="editorCol">
                        <th>@AppText.By</th>
                    </AuthorizeView>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _readings.OrderByDescending(r => r.MeasuredOn))
                {
                    <tr>
                        <td class="text-nowrap">@r.MeasuredOn.ToString("d")</td>
                        <td class="text-end">@r.Celsius.ToString("0.0")</td>
                        <td>@r.Note</td>
                        <AuthorizeView Roles="@AuthOptions.EditorRole" Context="editorCell">
                            <td class="text-nowrap small text-muted" title="@EditedTitle(r)">
                                @(r.LastEditedBy ?? "—")
                            </td>
                        </AuthorizeView>
                        <td class="text-end">
                            <AuthorizeView Roles="@AuthOptions.EditorRole">
                                <a href="@($"/edit/{r.Id}")">@AppText.Edit</a>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="graph-filter">
        <button type="button"
                class="btn @(!_stacked && _selectedYear is null ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => SelectYear(null)">
            @AppText.AllYears
        </button>

        <button type="button"
                class="btn @(_stacked ? "btn-primary" : "btn-outline-primary")"
                @onclick="ShowStacked">
            @AppText.CompareYears
        </button>

        <label class="year-select">
            <span class="visually-hidden">@AppText.FilterByYear</span>
            <select class="form-select"
                    value="@(!_stacked && _selectedYear is not null ? _selectedYear.ToString() : "")"
                    @onchange="OnYearChanged">
                <option value="">@AppText.SelectYear</option>
                @foreach (var year in _years)
                {
                    <option value="@year" selected="@(!_stacked && _selectedYear == year)">@year</option>
                }
            </select>
        </label>
    </div>

    <ApexChart @key="_chartKey"
               TItem="ChartPoint"
               Title="@_chartTitle"
               Options="_options">
        @if (_stacked)
        {
            @* One bar series per year, grouped by month, so the same part of the
               season can be compared across years side by side. *@
            @foreach (var g in _yearGroups)
            {
                <ApexPointSeries TItem="ChartPoint"
                                 Items="g.Points"
                                 Name="@g.Year.ToString()"
                                 SeriesType="SeriesType.Bar"
                                 XValue="@(p => p.Label)"
                                 YValue="@(p => p.Celsius)" />
            }
        }
        else
        {
            <ApexPointSeries TItem="ChartPoint"
                             Items="_linePoints"
                             Name="@AppText.SeriesTemperature"
                             SeriesType="SeriesType.Line"
                             ShowDataLabels="true"
                             XValue="@(p => p.MeasuredOn)"
                             YValue="@(p => p.Celsius)" />
        }
    </ApexChart>
}

@code {
    private enum View { List, Graph }

    private View _view = View.List;
    private IReadOnlyList<TemperatureReading>? _readings;

    // Graph year filter. null = show every year.
    private int? _selectedYear;

    // Compare mode: one bar series per year on a shared month axis.
    private bool _stacked;

    /// <summary>
    /// A single plotted point. <see cref="Celsius"/> is nullable so a year with no
    /// readings in a month leaves a gap in compare mode rather than a bar at zero,
    /// which lets every year carry the full set of month categories and keeps the
    /// grouped bars aligned with their labels.
    /// </summary>
    private sealed record ChartPoint(DateTime MeasuredOn, string Label, decimal? Celsius);

    // The single-series line. The chart is rendered server-side and cannot know
    // the visitor's colour preference, so this is the mid green (--green) that
    // clears 3:1 against both the light and the dark page background — unlike
    // --green-deep, which all but vanishes on the dark one. White data labels sit
    // on it at 5:1.
    private const string LineColor = "#3E7A57";

    // Validated categorical palette (dataviz skill, light surface) for the
    // per-year bars in compare mode. Fixed order — one hue per year, never cycled.
    private static readonly string[] YearColors =
        ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"];

    // Latest reading and all-time extremes (list header).
    private TemperatureReading _latest => _readings!.OrderByDescending(r => r.MeasuredOn).First();
    private TemperatureReading _allTimeMax => _readings!.OrderByDescending(r => r.Celsius).ThenBy(r => r.MeasuredOn).First();
    private TemperatureReading _allTimeMin => _readings!.OrderBy(r => r.Celsius).ThenBy(r => r.MeasuredOn).First();

    // Years present in the data, newest first, for the filter dropdown.
    private IReadOnlyList<int> _years =>
        _readings!.Select(r => r.MeasuredOn.Year).Distinct().OrderByDescending(y => y).ToList();

    // Chart order (oldest-first, left to right), filtered to the selected year when set.
    private List<TemperatureReading> _chartOrder =>
        _readings!
            .Where(r => _selectedYear is null || r.MeasuredOn.Year == _selectedYear)
            .OrderBy(r => r.MeasuredOn)
            .ToList();

    // The plotted points of the single-line mode, oldest first.
    private List<ChartPoint> _linePoints =>
        _chartOrder
            .Select(r => new ChartPoint(r.MeasuredOn.ToDateTime(TimeOnly.MinValue),
                                        r.MeasuredOn.ToString("MMM", CultureInfo.CurrentCulture),
                                        r.Celsius))
            .ToList();

    // Months that occur anywhere in the data, ascending — the shared category axis
    // of the compare mode.
    private IReadOnlyList<int> _months =>
        _readings!.Select(r => r.MeasuredOn.Month).Distinct().Order().ToList();

    // One bar series per year (ascending, so colour slots stay stable as new years
    // are added): the mean temperature per month. Every year gets a point for every
    // month on the axis, null where it has no readings, so the grouped bars line up.
    private IEnumerable<(int Year, List<ChartPoint> Points)> _yearGroups =>
        _readings!
            .GroupBy(r => r.MeasuredOn.Year)
            .OrderBy(g => g.Key)
            .Select(g => (g.Key, _months.Select(month =>
            {
                var inMonth = g.Where(r => r.MeasuredOn.Month == month).ToList();
                var date = new DateTime(2000, month, 1);
                return new ChartPoint(date,
                                      date.ToString("MMM", CultureInfo.CurrentCulture),
                                      inMonth.Count == 0 ? null : Math.Round(inMonth.Average(r => r.Celsius), 1));
            }).ToList()));

    // Distinct key per view so the chart is rebuilt cleanly when the mode changes.
    private string _chartKey => _stacked ? "stacked" : (_selectedYear?.ToString() ?? "all");

    private string _chartTitle =>
        _stacked ? AppText.ChartTitleMonthlyAverage
        : _selectedYear is null ? AppText.ChartTitle
        : AppText.ChartTitleForYear(_selectedYear.Value);

    private readonly ApexChartOptions<ChartPoint> _options = new()
    {
        Colors = [LineColor],
        Xaxis = new XAxis { Type = XAxisType.Datetime },
        Markers = new Markers { Size = 4 },
        Stroke = new Stroke { Curve = Curve.Straight, Width = 2 },
        // ApexCharts formats the datetime axis and its tooltip client-side, in
        // English unless it is handed a locale. Feed it the request's culture so
        // the dates on the chart match the dates in the table.
        Chart = new Chart { DefaultLocale = "app", Locales = [CurrentChartLocale()] },
    };

    /// <summary>
    /// The ApexCharts locale for the current request, built from the culture's own
    /// month and day names so a new UI language needs no extra chart translation.
    /// </summary>
    private static ChartLocale CurrentChartLocale()
    {
        var f = CultureInfo.CurrentCulture.DateTimeFormat;
        return new ChartLocale
        {
            Name = "app",
            Options = new LocaleOptions
            {
                // Trim the trailing empty 13th month .NET carries for 12-month calendars.
                Months = [.. f.MonthNames.Where(m => !string.IsNullOrEmpty(m))],
                ShortMonths = [.. f.AbbreviatedMonthNames.Where(m => !string.IsNullOrEmpty(m))],
                Days = [.. f.DayNames],
                ShortDays = [.. f.AbbreviatedDayNames],
                Toolbar = new LocaleToolbar
                {
                    Menu = AppText.ChartMenu,
                    Pan = AppText.ChartPan,
                    Reset = AppText.ChartReset,
                    Selection = AppText.ChartSelection,
                    SelectionZoom = AppText.ChartSelectionZoom,
                    ZoomIn = AppText.ChartZoomIn,
                    ZoomOut = AppText.ChartZoomOut,
                    ExportToPNG = AppText.ChartExportToPng,
                    ExportToSVG = AppText.ChartExportToSvg,
                    ExportToCSV = AppText.ChartExportToCsv,
                },
            },
        };
    }

    // Full provenance for the "By" column, shown on hover.
    private static string EditedTitle(TemperatureReading r) =>
        r.UpdatedAt is null
            ? AppText.AddedByOn(r.CreatedBy ?? AppText.Unknown, r.CreatedAt.ToLocalTime().ToString("g"))
            : AppText.AddedByOn(r.CreatedBy ?? AppText.Unknown, r.CreatedAt.ToLocalTime().ToString("g")) + "; " +
              AppText.EditedByOn(r.UpdatedBy ?? AppText.Unknown, r.UpdatedAt.Value.ToLocalTime().ToString("g"));

    private void OnYearChanged(ChangeEventArgs e)
    {
        SelectYear(int.TryParse(e.Value?.ToString(), out var year) ? year : null);
    }

    private void SelectYear(int? year)
    {
        _stacked = false;
        _selectedYear = year;
        ConfigureChart();
    }

    private void ShowStacked()
    {
        _stacked = true;
        ConfigureChart();
    }

    // Reconfigure the shared options object for the current mode. The chart is
    // rebuilt (see @key) so these take effect on the next render.
    private void ConfigureChart()
    {
        if (_stacked)
        {
            _options.Colors = [.. YearColors];
            _options.Markers!.Discrete = null;
            _options.DataLabels = new DataLabels { Enabled = false };
            // One category per month, with a bar per year inside it.
            _options.Xaxis!.Type = XAxisType.Category;
            _options.Xaxis.Labels = null;
            _options.PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar { ColumnWidth = "80%", BorderRadius = 3 },
            };
            // Bars carry their own fill; a stroke would only add a coloured outline.
            _options.Stroke!.Show = false;
            _options.Tooltip = new Tooltip { Shared = true, Intersect = false };
            _options.Legend = new Legend { Show = true };
        }
        else
        {
            _options.Colors = [LineColor];
            _options.Xaxis!.Type = XAxisType.Datetime;
            _options.Xaxis.Labels = null;
            _options.PlotOptions = null;
            _options.Stroke!.Show = true;
            _options.Tooltip = null;
            _options.Legend = new Legend { Show = false };
            UpdateExtremeMarkers();
        }
    }

    // Highlight the hottest and coldest points of the currently displayed data
    // with larger, coloured markers (red = high, blue = low) and always-on labels.
    private void UpdateExtremeMarkers()
    {
        var order = _chartOrder;
        if (order.Count == 0)
        {
            _options.Markers!.Discrete = null;
            _options.DataLabels = new DataLabels { Enabled = false };
            return;
        }

        int maxIdx = 0, minIdx = 0;
        for (var i = 1; i < order.Count; i++)
        {
            if (order[i].Celsius > order[maxIdx].Celsius) maxIdx = i;
            if (order[i].Celsius < order[minIdx].Celsius) minIdx = i;
        }

        var markers = new List<MarkersDiscrete>
        {
            new() { SeriesIndex = 0, DataPointIndex = maxIdx, FillColor = "#B23B32", StrokeColor = "#ffffff", Size = 7 },
        };
        if (minIdx != maxIdx)
        {
            markers.Add(new() { SeriesIndex = 0, DataPointIndex = minIdx, FillColor = "#3B6485", StrokeColor = "#ffffff", Size = 7 });
        }

        _options.Markers!.Discrete = markers;

        // Show a permanent value label on the min/max points only; every other
        // point returns an empty string, which ApexCharts skips (no stray pill).
        // A filled background pill keeps the white text readable in light or dark.
        _options.DataLabels = new DataLabels
        {
            Enabled = true,
            OffsetY = -10,
            Style = new DataLabelsStyle { FontSize = "12px", FontWeight = "700" },
            Background = new DataLabelsBackground { Enabled = true, ForeColor = "#ffffff", BorderWidth = 0 },
            Formatter = $"function(val, opts) {{ return (opts.dataPointIndex === {maxIdx} || opts.dataPointIndex === {minIdx}) ? val + '°C' : ''; }}",
        };
    }

    protected override async Task OnInitializedAsync()
    {
        _readings = await Repository.GetRecentAsync(1000);
        ConfigureChart();
    }
}
