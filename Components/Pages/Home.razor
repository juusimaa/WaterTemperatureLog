@page "/"
@inject ITemperatureRepository Repository
@rendermode InteractiveServer

<PageTitle>@AppText.AppName</PageTitle>

<h1 class="visually-hidden">@AppText.AppName</h1>

<div class="toolbar">
    <a class="btn btn-primary" href="/add">+ Add measurement</a>

    <div class="btn-group view-toggle" role="group" aria-label="View toggle">
        <button type="button"
                class="btn @(_view == View.List ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => _view = View.List">
            List
        </button>
        <button type="button"
                class="btn @(_view == View.Graph ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => _view = View.Graph">
            Graph
        </button>
    </div>
</div>

@if (_readings is null)
{
    <p><em>Loading…</em></p>
}
else if (_readings.Count == 0)
{
    <p>No readings yet. Be the first to <a href="/add">add one</a>.</p>
}
else if (_view == View.List)
{
    <p class="latest">
        Latest: <strong>@_latest.Celsius.ToString("0.0") °C</strong>
        <span class="text-muted">(@_latest.MeasuredOn.ToString("d"))</span>
    </p>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th class="text-end">°C</th>
                    <th>Spot</th>
                    <th>Note</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _readings.OrderByDescending(r => r.MeasuredOn))
                {
                    <tr>
                        <td class="text-nowrap">@r.MeasuredOn.ToString("d")</td>
                        <td class="text-end">@r.Celsius.ToString("0.0")</td>
                        <td>@r.Spot</td>
                        <td>@r.Note</td>
                        <td class="text-end"><a href="@($"/edit/{r.Id}")">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <ApexChart TItem="TemperatureReading"
               Title="Water temperature (°C)"
               Options="_options">
        <ApexPointSeries TItem="TemperatureReading"
                         Items="_chartOrder"
                         Name="Temperature"
                         SeriesType="SeriesType.Line"
                         XValue="@(r => r.MeasuredOn.ToDateTime(TimeOnly.MinValue))"
                         YValue="@(r => (decimal)r.Celsius)" />
    </ApexChart>
}

@code {
    private enum View { List, Graph }

    private View _view = View.List;
    private IReadOnlyList<TemperatureReading>? _readings;

    // Latest reading (list header) and chart order (oldest-first, left to right).
    private TemperatureReading _latest => _readings!.OrderByDescending(r => r.MeasuredOn).First();
    private List<TemperatureReading> _chartOrder => _readings!.OrderBy(r => r.MeasuredOn).ToList();

    private readonly ApexChartOptions<TemperatureReading> _options = new()
    {
        Xaxis = new XAxis { Type = XAxisType.Datetime },
        Markers = new Markers { Size = 4 },
        Stroke = new Stroke { Curve = Curve.Straight, Width = 2 },
    };

    protected override async Task OnInitializedAsync()
    {
        _readings = await Repository.GetRecentAsync(1000);
    }
}
