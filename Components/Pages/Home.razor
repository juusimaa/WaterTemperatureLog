@page "/"
@using WaterTemperatures.Data
@using WaterTemperatures.Models
@inject ITemperatureRepository Repository
@rendermode InteractiveServer

<PageTitle>Water temperatures — Torniojoki, Järhöinen</PageTitle>

<h1>Water temperatures</h1>
<p class="lead">Torniojoki river at Järhöinen village.</p>

<p>
    <a class="btn btn-primary" href="/add">+ Add a reading</a>
</p>

@if (_readings is null)
{
    <p><em>Loading…</em></p>
}
else if (_readings.Count == 0)
{
    <p>No readings yet. Be the first to <a href="/add">add one</a>.</p>
}
else
{
    <p class="latest">
        Latest: <strong>@_readings[0].Celsius.ToString("0.0") °C</strong>
        <span class="text-muted">(@_readings[0].MeasuredAt.LocalDateTime.ToString("g"))</span>
    </p>

    <table class="table">
        <thead>
            <tr>
                <th>Measured</th>
                <th class="text-end">°C</th>
                <th>Spot</th>
                <th>Note</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _readings)
            {
                <tr>
                    <td>@r.MeasuredAt.LocalDateTime.ToString("g")</td>
                    <td class="text-end">@r.Celsius.ToString("0.0")</td>
                    <td>@r.Spot</td>
                    <td>@r.Note</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<TemperatureReading>? _readings;

    protected override async Task OnInitializedAsync()
    {
        _readings = await Repository.GetRecentAsync();
    }
}
