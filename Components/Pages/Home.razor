@page "/"
@inject ITemperatureRepository Repository
@rendermode InteractiveServer

<PageTitle>@AppText.AppName</PageTitle>

<div class="wt-wrap">
    <div style="padding-top: var(--space-6); padding-bottom: var(--space-4);">
        <h1 style="margin-bottom: var(--space-2);">@AppText.AppName</h1>
        <p class="text-muted" style="max-width: 56ch;">@AppText.MetaDescription</p>
    </div>

    <AuthorizeView Roles="@AuthOptions.EditorRole">
        <div style="margin-bottom: var(--space-4);">
            <a class="btn btn-primary" href="/add">@AppText.AddMeasurement</a>
        </div>
    </AuthorizeView>

    @if (_readings is null)
    {
        <p><em>@AppText.Loading</em></p>
    }
    else if (_readings.Count == 0)
    {
        <p>@AppText.NoReadingsYet <a href="/add">@AppText.AddTheFirstOne</a></p>
    }
    else
    {
        @* All three read from _measured, so each is null only when no reading carries a
           temperature at all — in which case there is no statistic to show. *@
        @if (_latest is not null && _allTimeMax is not null && _allTimeMin is not null)
        {
            <div class="wt-stats" style="margin-bottom: var(--space-6);">
                <div class="card elev-sm">
                    <div class="card-kicker">@AppText.StatLatest</div>
                    <div class="card-title" style="font-size: 26px;">@Temp(_latest) °C</div>
                    <div class="card-meta">@_latest.MeasuredOn.ToString("d")</div>
                </div>
                <div class="card elev-sm">
                    <div class="card-kicker">@AppText.StatAllTimeHigh</div>
                    <div class="card-title" style="font-size: 26px; color: var(--color-accent-700);">@Temp(_allTimeMax) °C</div>
                    <div class="card-meta">@_allTimeMax.MeasuredOn.ToString("d")</div>
                </div>
                <div class="card elev-sm">
                    <div class="card-kicker">@AppText.StatAllTimeLow</div>
                    <div class="card-title" style="font-size: 26px; color: var(--color-accent-2-700);">@Temp(_allTimeMin) °C</div>
                    <div class="card-meta">@_allTimeMin.MeasuredOn.ToString("d")</div>
                </div>
            </div>
        }

        <div class="seg" style="margin-bottom: var(--space-4);">
            <label class="seg-opt">
                <input type="radio" name="view" checked="@(_view == View.List)" @onchange="() => _view = View.List">
                <span>@AppText.ViewList</span>
            </label>
            <label class="seg-opt">
                <input type="radio" name="view" checked="@(_view == View.Chart)" @onchange="() => _view = View.Chart">
                <span>@AppText.ViewGraph</span>
            </label>
        </div>

        <div class="wt-lower" style="margin-bottom: var(--space-4);">
            <div>
                @if (_view == View.List)
                {
                    @* Columns carry cell-* classes so the phone stylesheet can re-flow the same
                       markup into one card per reading (see Home.razor.css): a wide table in a
                       horizontal scroller would leave the Edit link off-screen on a phone. *@
                    <div class="card elev-sm wt-table-wrap" style="padding: 0;">
                        <table class="table readings">
                            <thead>
                                <tr>
                                    <th>@AppText.Date</th>
                                    <th>°C</th>
                                    <th>@AppText.Note</th>
                                    @* Editor emails are shown to editors only, not to public visitors. *@
                                    <AuthorizeView Roles="@AuthOptions.EditorRole" Context="editorCol">
                                        <th>@AppText.By</th>
                                    </AuthorizeView>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _readings.OrderByDescending(r => r.MeasuredOn))
                                {
                                    <tr>
                                        <td class="cell-date">@r.MeasuredOn.ToString("d")</td>
                                        <td class="cell-temp" style="font-weight: 700;">@Temp(r)</td>
                                        <td class="cell-note wt-row-note">@r.Note</td>
                                        <AuthorizeView Roles="@AuthOptions.EditorRole" Context="editorCell">
                                            <td class="cell-by wt-row-note" title="@EditedTitle(r)">
                                                @(r.LastEditedBy ?? "—")
                                            </td>
                                        </AuthorizeView>
                                        <td class="cell-edit">
                                            <AuthorizeView Roles="@AuthOptions.EditorRole">
                                                <a href="@($"/edit/{r.Id}")">@AppText.Edit</a>
                                            </AuthorizeView>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="card elev-sm" style="padding: var(--space-4);">
                        <TemperatureChart Readings="_measuredList" />
                    </div>
                }
            </div>

            <div class="card elev-sm" style="padding: var(--space-3);">
                <div class="card-kicker" style="margin-bottom: var(--space-2);">@AppText.LocationLabel</div>
                <iframe class="wt-map-frame washed" src="@MapSrc" loading="lazy" title="@AppText.Subtitle"></iframe>
                <div class="card-meta" style="margin-top: var(--space-2);">@AppText.Subtitle</div>
            </div>
        </div>
    }
</div>

@code {
    private enum View { List, Chart }

    private View _view = View.List;
    private IReadOnlyList<TemperatureReading>? _readings;

    // Centered on the Tornio River at Jarhoinen village.
    private const string MapSrc = "https://www.openstreetmap.org/export/embed.html?bbox=23.79%2C66.92%2C23.93%2C66.98&layer=mapnik&marker=66.951%2C23.86";

    /// <summary>
    /// Readings that carry a temperature. <c>[Required]</c> keeps null out of the store,
    /// so in practice this is every reading — but the statistics and the chart extremes
    /// derive from it rather than from <c>_readings</c> so they stay correct by
    /// construction. Ordering by a nullable sorts null below every real value, which
    /// would otherwise hand "all-time low" to a reading that has no temperature at all.
    /// </summary>
    private IEnumerable<TemperatureReading> _measured => _readings!.Where(r => r.Celsius is not null);

    // TemperatureChart takes a list (it indexes/re-enumerates it several times while
    // building the SVG), rather than the lazy _measured sequence.
    private List<TemperatureReading> _measuredList => _measured.ToList();

    /// <summary>Formats a reading's temperature, or an em dash if it somehow has none.</summary>
    private static string Temp(TemperatureReading r) => r.Celsius?.ToString("0.0") ?? "—";

    // Latest reading and all-time extremes (list header). Null only when nothing is measured.
    private TemperatureReading? _latest => _measured.OrderByDescending(r => r.MeasuredOn).FirstOrDefault();
    private TemperatureReading? _allTimeMax => _measured.OrderByDescending(r => r.Celsius).ThenBy(r => r.MeasuredOn).FirstOrDefault();
    private TemperatureReading? _allTimeMin => _measured.OrderBy(r => r.Celsius).ThenBy(r => r.MeasuredOn).FirstOrDefault();

    // Full provenance for the "By" column, shown on hover.
    private static string EditedTitle(TemperatureReading r) =>
        r.UpdatedAt is null
            ? AppText.AddedByOn(r.CreatedBy ?? AppText.Unknown, r.CreatedAt.ToLocalTime().ToString("g"))
            : AppText.AddedByOn(r.CreatedBy ?? AppText.Unknown, r.CreatedAt.ToLocalTime().ToString("g")) + "; " +
              AppText.EditedByOn(r.UpdatedBy ?? AppText.Unknown, r.UpdatedAt.Value.ToLocalTime().ToString("g"));

    protected override async Task OnInitializedAsync()
    {
        _readings = await Repository.GetRecentAsync(1000);
    }
}
