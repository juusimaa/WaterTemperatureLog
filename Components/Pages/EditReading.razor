@page "/edit/{id}"
@using System.Security.Claims
@inject ITemperatureRepository Repository
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@rendermode InteractiveServer

<PageTitle>Edit reading — @AppText.AppName</PageTitle>

<h1>Edit reading</h1>

<AuthorizeView Roles="@AuthOptions.EditorRole">
    <Authorized>
        @if (_loading)
        {
            <p><em>Loading…</em></p>
        }
        else if (_model is null)
        {
            <div class="alert alert-warning">Reading not found.</div>
            <a class="btn btn-secondary" href="/">Back</a>
        }
        else
        {
            @if (_error is not null)
            {
                <div class="alert alert-warning">@_error</div>
            }

            <ReadingForm Model="_model" SubmitLabel="Update" OnValidSubmit="SaveAsync" DateReadOnly="true">
                <ExtraButtons>
                    <button type="button" class="btn btn-outline-danger float-end" @onclick="DeleteAsync">
                        Delete
                    </button>
                </ExtraButtons>
            </ReadingForm>

            <p class="text-muted small mt-3">
                Added by @(_model.CreatedBy ?? "unknown") on @_model.CreatedAt.ToLocalTime().ToString("g")
                @if (_model.UpdatedAt is not null)
                {
                    <text>&#160;· last edited by @(_model.UpdatedBy ?? "unknown") on @_model.UpdatedAt.Value.ToLocalTime().ToString("g")</text>
                }
            </p>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-info">
            You need to be signed in as an editor to change readings.
            <a href="@($"/.auth/login/google?post_login_redirect_uri=/edit/{Id}")" data-enhance-nav="false">Log in</a>.
        </div>
        <a class="btn btn-secondary" href="/">Back</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public string Id { get; set; } = default!;

    private TemperatureReading? _model;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _model = await Repository.GetByIdAsync(Id);
        _loading = false;
    }

    private async Task SaveAsync()
    {
        var editor = await CurrentEditorAsync();
        if (editor is null)
        {
            return;
        }

        _error = null;
        _model!.UpdatedBy = editor;
        _model.UpdatedAt = DateTimeOffset.UtcNow;

        // The date is read-only on this form, so the id cannot have moved; a false
        // result means someone deleted the reading while it was open.
        if (!await Repository.UpdateAsync(_model))
        {
            _error = "This reading was deleted by someone else, so it could not be updated.";
            return;
        }

        Nav.NavigateTo("/");
    }

    private async Task DeleteAsync()
    {
        if (await CurrentEditorAsync() is null)
        {
            return;
        }

        await Repository.DeleteAsync(Id);
        Nav.NavigateTo("/");
    }

    /// <summary>
    /// The signed-in editor's email, or null if the user may not write. Doubles as the
    /// server-side guard: never write or delete unless this returns non-null.
    /// </summary>
    private async Task<string?> CurrentEditorAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (!state.User.IsInRole(AuthOptions.EditorRole))
        {
            return null;
        }

        return state.User.FindFirst(ClaimTypes.Email)?.Value ?? state.User.Identity?.Name;
    }
}
