@page "/edit/{id}"
@using System.Security.Claims
@inject ITemperatureRepository Repository
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@rendermode InteractiveServer

<PageTitle>@AppText.EditReading — @AppText.AppName</PageTitle>

<h1>@AppText.EditReading</h1>

<AuthorizeView Roles="@AuthOptions.EditorRole">
    <Authorized>
        @if (_loading)
        {
            <p><em>@AppText.Loading</em></p>
        }
        else if (_model is null)
        {
            <div class="alert alert-warning">@AppText.ReadingNotFound</div>
            <a class="btn btn-secondary" href="/">@AppText.Back</a>
        }
        else
        {
            @if (_error is not null)
            {
                <div class="alert alert-warning">@_error</div>
            }

            @if (_confirmingDelete)
            {
                <div class="alert alert-danger">
                    @AppText.DeleteConfirmPrefix <strong>@_model.MeasuredOn.ToString("d")</strong>
                    @AppText.DeleteConfirmSuffix(_model.Celsius.ToString("0.0"))
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteAsync">
                            @AppText.YesDeleteIt
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                @onclick="() => _confirmingDelete = false">
                            @AppText.Cancel
                        </button>
                    </div>
                </div>
            }

            <ReadingForm Model="_model" SubmitLabel="@AppText.Update" OnValidSubmit="SaveAsync" DateReadOnly="true">
                <ExtraButtons>
                    <button type="button" class="btn btn-outline-danger float-end"
                            @onclick="() => _confirmingDelete = true">
                        @AppText.Delete
                    </button>
                </ExtraButtons>
            </ReadingForm>

            <p class="text-muted small mt-3">
                @AppText.AddedByOn(_model.CreatedBy ?? AppText.Unknown, _model.CreatedAt.ToLocalTime().ToString("g"))
                @if (_model.UpdatedAt is not null)
                {
                    <text>&#160;· @AppText.EditedByOn(_model.UpdatedBy ?? AppText.Unknown, _model.UpdatedAt.Value.ToLocalTime().ToString("g"))</text>
                }
            </p>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-info">
            @AppText.NeedEditorToChange
            <a href="@($"/.auth/login/google?post_login_redirect_uri=/edit/{Id}")" data-enhance-nav="false">@AppText.LogIn</a>.
        </div>
        <a class="btn btn-secondary" href="/">@AppText.Back</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public string Id { get; set; } = default!;

    private TemperatureReading? _model;
    private bool _loading = true;
    private string? _error;
    private bool _confirmingDelete;

    protected override async Task OnInitializedAsync()
    {
        _model = await Repository.GetByIdAsync(Id);
        _loading = false;
    }

    private async Task SaveAsync()
    {
        var editor = await CurrentEditorAsync();
        if (editor is null)
        {
            return;
        }

        _error = null;
        _model!.UpdatedBy = editor;
        _model.UpdatedAt = DateTimeOffset.UtcNow;

        // The date is read-only on this form, so the id cannot have moved; a false
        // result means someone deleted the reading while it was open.
        if (!await Repository.UpdateAsync(_model))
        {
            _error = AppText.UpdateFailedDeleted;
            return;
        }

        Nav.NavigateTo("/");
    }

    private async Task DeleteAsync()
    {
        var editor = await CurrentEditorAsync();
        if (editor is null)
        {
            return;
        }

        _confirmingDelete = false;

        // Soft delete: the reading is hidden, not destroyed, so a mis-click is recoverable.
        if (!await Repository.DeleteAsync(Id, editor))
        {
            _error = AppText.AlreadyDeleted;
            return;
        }

        Nav.NavigateTo("/");
    }

    /// <summary>
    /// The signed-in editor's email, or null if the user may not write. Doubles as the
    /// server-side guard: never write or delete unless this returns non-null.
    /// </summary>
    private async Task<string?> CurrentEditorAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (!state.User.IsInRole(AuthOptions.EditorRole))
        {
            return null;
        }

        return state.User.FindFirst(ClaimTypes.Email)?.Value ?? state.User.Identity?.Name;
    }
}
