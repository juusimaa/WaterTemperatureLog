@page "/add"
@using System.Security.Claims
@inject ITemperatureRepository Repository
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@rendermode InteractiveServer

<PageTitle>Add a reading — @AppText.AppName</PageTitle>

<h1>Add a reading</h1>

<AuthorizeView Roles="@AuthOptions.EditorRole">
    <Authorized>
        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }
        else if (_duplicate is not null)
        {
            <div class="alert alert-warning">
                A reading for <strong>@_duplicate.MeasuredOn.ToString("d")</strong> already
                exists (@_duplicate.Celsius.ToString("0.0") °C). There is one reading per day.
                <div class="mt-2">
                    <a class="btn btn-sm btn-primary" href="@($"/edit/{_duplicate.Id}")">Edit that reading</a>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _duplicate = null">
                        Pick another date
                    </button>
                </div>
            </div>
        }

        <ReadingForm Model="_model" SubmitLabel="Save" OnValidSubmit="SaveAsync" />
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-info">
            You need to be signed in as an editor to add readings.
            <a href="/.auth/login/google?post_login_redirect_uri=/add" data-enhance-nav="false">Log in</a>.
        </div>
        <a class="btn btn-secondary" href="/">Back</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    // MeasuredOn defaults to today via the model initializer.
    private readonly TemperatureReading _model = new();

    // The reading already stored for the chosen date, when the save was rejected.
    private TemperatureReading? _duplicate;

    private string? _error;

    private async Task SaveAsync()
    {
        // Server-side guard: never write unless the current user is an editor.
        var editor = await CurrentEditorAsync();
        if (editor is null)
        {
            return;
        }

        _duplicate = null;
        _error = null;

        // Check first, so the common case gets a helpful message instead of an error.
        var existing = await Repository.GetByIdAsync(TemperatureReading.IdFor(_model.MeasuredOn));
        if (existing is not null)
        {
            _duplicate = existing;
            return;
        }

        _model.CreatedBy = editor;
        _model.CreatedAt = DateTimeOffset.UtcNow;

        // The check above is racy — two editors can pass it at the same time — so the
        // store's own rejection is the real guard, and it must not reach the error page.
        if (await Repository.AddAsync(_model) == AddResult.DuplicateDate)
        {
            _duplicate = await Repository.GetByIdAsync(_model.Id);
            if (_duplicate is null)
            {
                // Added and then deleted again while we were saving. Vanishingly rare,
                // but say so rather than pretending the reading was stored.
                _error = "That reading could not be saved. Please try again.";
            }
            return;
        }

        Nav.NavigateTo("/");
    }

    /// <summary>The signed-in editor's email, or null if the user may not write.</summary>
    private async Task<string?> CurrentEditorAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (!state.User.IsInRole(AuthOptions.EditorRole))
        {
            return null;
        }

        return state.User.FindFirst(ClaimTypes.Email)?.Value ?? state.User.Identity?.Name;
    }
}
