@page "/graph"
@inject ITemperatureRepository Repository
@rendermode InteractiveServer

<PageTitle>Graph — @AppText.AppName</PageTitle>

<h1>Temperature graph</h1>
<p class="lead">@AppText.Subtitle</p>

@if (_readings is null)
{
    <p><em>Loading…</em></p>
}
else if (_readings.Count == 0)
{
    <p>No readings yet. <a href="/add">Add one</a> to see the graph.</p>
}
else
{
    <ApexChart TItem="TemperatureReading"
               Title="Water temperature (°C)"
               Options="_options">
        <ApexPointSeries TItem="TemperatureReading"
                         Items="_readings"
                         Name="Temperature"
                         SeriesType="SeriesType.Line"
                         XValue="@(r => r.MeasuredOn.ToDateTime(TimeOnly.MinValue))"
                         YValue="@(r => (decimal)r.Celsius)" />
    </ApexChart>
}

@code {
    private List<TemperatureReading>? _readings;

    private readonly ApexChartOptions<TemperatureReading> _options = new()
    {
        Xaxis = new XAxis { Type = XAxisType.Datetime },
        Markers = new Markers { Size = 4 },
        Stroke = new Stroke { Curve = Curve.Straight, Width = 2 },
    };

    protected override async Task OnInitializedAsync()
    {
        var readings = await Repository.GetRecentAsync(1000);
        // Chart expects oldest-first so the line reads left to right.
        _readings = readings.OrderBy(r => r.MeasuredOn).ToList();
    }
}
